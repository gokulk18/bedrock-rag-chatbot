# ==============================================================================
# Sample Terraform Input Variables
# ==============================================================================
# Copy or rename this file to 'terraform.tfvars' to override default values.
# DO NOT commit real secrets or sensitive keys into version control.
# ==============================================================================

project_name       = "bedrock-rag-chatbot"
environment        = "dev"
aws_region         = "us-east-1"
owner              = "devops-team"
bedrock_model_id   = "anthropic.claude-3-5-sonnet-20241022-v2:0"
budget_limit_usd   = 100
budget_alert_email = "devops@example.com"

common_tags = {
  Repository = "https://github.com/example/bedrock-rag-chatbot"
  CostCenter = "engineering-ai"
}
